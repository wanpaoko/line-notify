# Google Gemini API 設定 (用於 ai-news.py, stock-news.py, birthday-notify.py)
GEMINI_API_KEY=your-gemini-api-key-here

# LINE Messaging API 設定 (用於 ai-news.py, stock-news.py, ispo-shopback.py, garmin-run.py, birthday-notify.py)
CHANNEL_ACCESS_TOKEN=your-channel-access-token-here
USER_ID=your-line-user-id-here

# LINE Notify 設定 (用於 ispo-shopback.py, garmin-run.py)
LINE_NOTIFY_TOKEN=your-line-notify-token-here

# ShopBack ISPO 回饋百分比門檻 (預設 10.0)
CASHBACK_THRESHOLD=10.0
