# Google Gemini API 設定
GEMINI_API_KEY=your-gemini-api-key-here

# Confluence 設定
CONFLUENCE_URL=https://trendmicro.atlassian.net
CONFLUENCE_USERNAME=your-email@trendmicro.com
CONFLUENCE_API_TOKEN=your-confluence-api-token-here
# 父頁面 ID - 新頁面會建立在此頁面之下
CONFLUENCE_PARENT_PAGE_ID=1969488035

# LINE Messaging API 設定（用於 my-news.py）
CHANNEL_ACCESS_TOKEN=your-channel-access-token-here
USER_ID=your-line-user-id-here

# LINE Notify 設定（用於 ShopBack 回饋通知）
LINE_NOTIFY_TOKEN=your-line-notify-token-here
# 回饋百分比門檻（預設 9.0）
CASHBACK_THRESHOLD=9.0
